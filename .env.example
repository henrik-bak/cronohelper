# Copy to .env and fill in. .env is gitignored and is never read by the browser.
# These are the only two secrets in the app. They are passed to the container as
# env vars, used solely to obtain a Cronometer session token, and never logged,
# never persisted, and never included in an API response.

CRONOMETER_USERNAME=you@example.com
CRONOMETER_PASSWORD=your-cronometer-password

# Diary entries are stamped in the account's timezone. Keep this aligned with
# your Cronometer account setting or the date you write may not be the date you
# meant (a 23:30 Budapest import can land on the previous day under UTC).
TZ=Europe/Budapest

# Optional: force the account timezone used when stamping diary entries.
# The upstream client resolves this from the login response; set this only if
# that value is wrong for your account.
# CRONOMETER_ACCOUNT_TZ=Europe/Budapest

# Host port to publish the UI on.
PORT=8080
